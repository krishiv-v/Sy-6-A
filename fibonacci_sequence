def fib_iter(n):
    if n < 0:
        raise ValueError("Input must be a non-negative integer.")
    if n == 0:
        return 0
    elif n == 1:
        return 1

    a, b = 0, 1
    for _ in range(2, n + 1):
        c = a + b
        a = b
        b = c

    return b


def main():
    print("=" * 45)
    print("      EFFICIENT FIBONACCI CALCULATOR")
    print("=" * 45)

    n = 22

    result = fib_iter(n)

    print("-" * 45)
    print(f"The {n}th Fibonacci number is: {result}")
    print("-" * 45)


if __name__ == "__main__":
    main()
